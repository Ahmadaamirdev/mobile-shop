{
  "name": "unity-mobile-shop",
  "version": "1.0.0",
  "description": "Unity Mobile Shop Management Web App - MERN Monorepo",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend run build",
    "start": "npm run start --prefix backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.13.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
